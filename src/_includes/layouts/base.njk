<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title and title != site.title %}{{ title }} · {% endif %}{{ site.title }}</title>
    {% if description %}<meta name="description" content="{{ description }}" />{% endif %}
    {% if noindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}
    {#- Résumé landing pages (/r/<company>/) bounce onward. The 2s delay is
        deliberate: a 0-second refresh can cancel the analytics beacon below
        before it fires, and the hit is the entire point of the page. #}
    {% if redirect %}<meta http-equiv="refresh" content="2; url={{ redirect }}" />{% endif %}

    {# Open Graph / Twitter card — banner unfurls when the site is shared. #}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{% if title and title != site.title %}{{ title }} · {% endif %}{{ site.title }}" />
    {% if description %}<meta property="og:description" content="{{ description }}" />{% endif %}
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}/banner.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="{{ site.url }}/banner.png" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/css/tufte.css" />
    <link rel="stylesheet" href="/css/extra.css" />
  </head>
  <body>
    <article>
      <header class="site-header">
        <nav>
          {%- for item in site.nav %}
          <a href="{{ item.url }}">{{ item.text }}</a>{% if not loop.last %} · {% endif %}
          {%- endfor %}
        </nav>
      </header>

      {{ content | safe }}

      <footer class="site-footer">
        <p class="subtitle">
          {%- for link in site.links %}
          <a href="{{ link.url }}">{{ link.text }}</a>{% if not loop.last %} · {% endif %}
          {%- endfor %}
        </p>
      </footer>
    </article>

    {#- GoatCounter: cookieless pageview counting (no consent banner needed).
        count.js skips localhost by itself, so ./serve doesn't pollute the
        stats. Bots don't run JS, which is why link-unfurl and ATS-scanner
        fetches of a /r/ URL don't show up as visits. #}
    <script data-goatcounter="https://veesh.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>
    <script>
      // Outbound clicks as GoatCounter events. On a résumé landing page this is
      // the second signal worth having: not just "they arrived", but "they
      // clicked through to the LSP repo".
      document.addEventListener("click", function (e) {
        var a = e.target.closest && e.target.closest("a[href^='http']");
        if (!a || a.host === location.host) return;
        if (!window.goatcounter || !window.goatcounter.count) return;
        window.goatcounter.count({
          path: "out:" + a.host + a.pathname,
          title: (a.textContent || "").trim(),
          event: true,
        });
      });
    </script>
  </body>
</html>
